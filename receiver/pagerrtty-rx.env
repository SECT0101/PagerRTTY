# /etc/default/pagerrtty-rx  (systemd: comments on their own lines only)

# Node-RED host running the "PagerRTTY to TAK" flow, and its "udp in" port
NR_HOST=nodered.example.net
NR_PORT=4545

# Tones: PagerRTTY mark/space (about 170 Hz shift, centered at 4000 Hz)
MARK=3909
SPACE=4091

# Sound card: blank = default, e.g. plughw:1,0 for a USB card (see: arecord -l)
ALSA_DEV=

# Tag sent with each line: blank = this machine's hostname
SRC_TAG=
